{
  "manifest_version": 3,
  "name": "reIDM Integration",
  "version": "1.6.0",
  "key": "",
  "description": "Lets the reIDM download manager take over the browser's downloads, and finds video, audio and every resource on a page. Independent of the IDM extension.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "reIDM",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options.html",
  "permissions": [
    "downloads",
    "contextMenus",
    "scripting",
    "webRequest",
    "storage",
    "tabs",
    "cookies",
    "nativeMessaging",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
